[Unit]
Description=TPMS JSON API — reads /var/lib/tpms/tpms.sqlite3, serves :8090
Documentation=https://github.com/tclancy/radiofrequency/issues/7
After=network.target

[Service]
Type=simple
User=pi
Group=pi
Environment=TPMS_DB=/var/lib/tpms/tpms.sqlite3
Environment=TPMS_LOW_PSI=30.0
Environment=TPMS_STALE_SECONDS=900
WorkingDirectory=/home/pi/tpms
ExecStart=/home/pi/tpms/.venv/bin/python -m src.tpms.api
Restart=on-failure
RestartSec=15
StandardError=append:/var/log/tpms/api.log

[Install]
WantedBy=default.target
